<Window x:Class="EnclaveApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enclave" Height="490" Width="540"
        MinHeight="470" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Icon="AppIcon.ico"
        Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Enclave" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="AES-256-GCM · Argon2id keys · SHA-512 filename hash"
                       FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Drop area -->
        <Border Grid.Row="1" x:Name="DropArea"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1.5" CornerRadius="10"
                AllowDrop="True"
                DragEnter="DropArea_DragEnter" DragLeave="DropArea_DragLeave" Drop="DropArea_Drop">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                <TextBlock x:Name="DropHint" Text="Drag a file or folder here"
                           FontSize="15" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SelectedPathText" Text="" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,8,0,0" MaxWidth="440"/>
            </StackPanel>
        </Border>

        <!-- Choose buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Choose File…" Click="ChooseFile_Click"/>
            <Button Content="Choose Folder…" Click="ChooseFolder_Click"/>
        </StackPanel>

        <!-- Password + options -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"/>
            <CheckBox x:Name="EncryptFilenameCheck" Content="Encrypt filename (uncheck to keep the name visible)"
                      IsChecked="True" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Actions -->
        <Grid Grid.Row="4" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Help" MinWidth="72" Click="Help_Click"/>
                <Button Content="About" MinWidth="72" Click="About_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="EncryptButton" Content="Encrypt" Click="Encrypt_Click"
                        Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="DecryptButton" Content="Decrypt" Click="Decrypt_Click" Margin="0"/>
            </StackPanel>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="5" x:Name="StatusText" Text="" Margin="0,14,0,0"
                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
    </Grid>
</Window>
